# Setup dates
START_DATE=$(date -d "-30 days" +%s)
CURRENT_DATE=$(date +%s)
INTERVAL=$(( (CURRENT_DATE - START_DATE) / 35 )) # Spread ~35 commits over 30 days

get_date() {
    local offset=$1
    date -d "@$((START_DATE + (offset * INTERVAL)))" "+%Y-%m-%d %H:%M:%S"
}

